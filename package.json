{
  "name": "escort-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:apps": "concurrently -k -n api,web -c cyan,magenta \"npm run dev --workspace=@escort/api\" \"npm run dev --workspace=@escort/web\"",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "npm run db:migrate --workspace=@escort/db",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "db:bootstrap": "npm run db:migrate --workspace=@escort/db && npm run seed:admin --workspace=@escort/api && npm run seed:client --workspace=@escort/api && npm run seed:models --workspace=@escort/api",
    "db:align-password": "node scripts/align-postgres-password-with-env.mjs",
    "verify:database": "node scripts/verify-database-url.mjs",
    "ensure:database": "node scripts/ensure-database-url.mjs",
    "check:postgres-env": "node scripts/check-postgres-password-sync.mjs",
    "pm2:reload-api": "node scripts/legacy-deploy-disabled.mjs",
    "pm2:reload-web": "node scripts/legacy-deploy-disabled.mjs",
    "pm2:hard-reload-api": "node scripts/legacy-deploy-disabled.mjs",
    "vps:after-pull": "node scripts/legacy-deploy-disabled.mjs",
    "vps:preview": "bash scripts/vps-preview.sh",
    "vps:preview:down": "bash scripts/vps-preview.sh --down",
    "clean": "turbo run clean && rm -rf node_modules",
    "arch-map:generate": "node scripts/generate-project-arch-map.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "sharp": "0.35.5"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
